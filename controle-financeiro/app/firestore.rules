rules_version = '2';
// Cada "casa" tem uma lista de e-mails (membros). Só eles leem e gravam os dados dela.
service cloud.firestore {
  match /databases/{database}/documents {
    function logado() { return request.auth != null && request.auth.token.email != null; }
    function email() { return request.auth.token.email.lower(); }
    function membro(casa) { return logado() && email() in get(/databases/$(database)/documents/casas/$(casa)).data.membros; }
    match /casas/{casa} {
      allow read: if logado() && email() in resource.data.membros;
      allow create: if logado() && casa == request.auth.uid && request.resource.data.membros == [email()];
      allow update: if logado() && email() in resource.data.membros && request.resource.data.membros.size() > 0;
      allow delete: if false;
      match /{resto=**} {
        allow read, write: if membro(casa);
      }
    }
  }
}
